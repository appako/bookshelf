{
    "name": "bookshelf",
    "version": "1.0.0",
    "private": true,
    "description": "Reaktivate Fast-Test homework: books list refactored to MVP (View / Controller / Repository / Gateway) with MobX",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "api:gen": "orval --config orval.config.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "axios": "^1.20.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "mobx": "^6.16.1",
        "mobx-react-lite": "^4.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "jsdom": "^29.1.1",
        "orval": "^8.43.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
